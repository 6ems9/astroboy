---
import {
  contactInfo,
  socialMedia,
  about,
  experience,
  education,
} from "../data/about_resume";
import { portfolioItems } from "../data/portfolio";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>AstroBoy | Folio vCard</title>
    <!-- Font Outfit -->
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Icon Font -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
  </head>

  <body>
    <div class="vcard-wrapper">
      <!-- Left Sidebar -->
      <aside class="panel-box sidebar">
        <img src={contactInfo.image} alt="Avatar" class="avatar" />
        <h1 class="name">{contactInfo.name}</h1>
        <p class="role">{contactInfo.role}</p>

        <div class="divider"></div>

        <div class="contact-info">
          <div class="contact-item">
            <i class="fa-solid fa-phone icon"></i>
            <div>
              <span>Phone</span>
              <p>{contactInfo.phone}</p>
            </div>
          </div>
          <div class="contact-item">
            <i class="fa-solid fa-envelope icon"></i>
            <div>
              <span>Email</span>
              <p>{contactInfo.email}</p>
            </div>
          </div>
          <div class="contact-item">
            <i class="fa-solid fa-location-dot icon"></i>
            <div>
              <span>Location</span>
              <p>{contactInfo.location}</p>
            </div>
          </div>
        </div>

        <div class="social-links">
          <a
            href={socialMedia.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
          >
            <i class="fa-brands fa-facebook"></i>
          </a>
          <a
            href={socialMedia.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
          >
            <i class="fa-brands fa-instagram"></i>
          </a>
          <a
            href={socialMedia.github}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
          >
            <i class="fa-brands fa-github"></i>
          </a>
        </div>
      </aside>

      <!-- Right Main Content -->
      <main class="panel-box main-window">
        <!-- NAVBAR (Sticky) -->
        <nav class="inner-navbar">
          <a href="#about" class="nav-link active">About</a>
          <a href="#resume" class="nav-link">Resume</a>
          <a href="#portfolio" class="nav-link">Portfolio</a>
          <a href="#contact" class="nav-link">Contact</a>
        </nav>

        <!-- SCROLL AREA -->
        <div class="scrollable-area">
          <!-- 1. ABOUT -->
          <section id="about" class="content-section">
            <h2 class="section-title">
              <i class="fa-solid fa-user-astronaut"></i> About Me
            </h2>
            <p class="text-muted">
              {about.description}
            </p>

            <div class="about-grid mt-5">
              <div class="sub-card">
                <h3 class="section-subtitle">
                  <i class="fa-solid fa-code"></i> What i'm doing
                </h3>
                <div class="tags mt-3">
                  {
                    about.skills.map((skill) => (
                      <span class="tag">{skill}</span>
                    ))
                  }
                </div>
              </div>

              <div class="sub-card stats-flex">
                <div class="stat">
                  <h4>{about.experience}</h4>
                  <p>Years of Experience</p>
                </div>
                <div class="stat">
                  <h4>{about.project}</h4>
                  <p>Projects Completed</p>
                </div>
              </div>
            </div>
          </section>

          <!-- 2. RESUME -->
          <section id="resume" class="content-section">
            <h2 class="section-title">
              <i class="fa-solid fa-graduation-cap"></i> Resume
            </h2>

            <div class="resume-category">
              <h3 class="section-subtitle">
                <i class="fa-solid fa-briefcase"></i> Experience
              </h3>
              <div class="timeline">
                {
                  experience.map((item) => (
                    <div class="timeline-item">
                      <h4 class="timeline-title">{item.position}</h4>
                      <span class="timeline-period">{item.period}</span>
                      <p class="text-muted">{item.description}</p>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="resume-category mt-5">
              <h3 class="section-subtitle">
                <i class="fa-solid fa-book-open"></i> Education
              </h3>
              <div class="timeline">
                {
                  education.map((item) => (
                    <div class="timeline-item">
                      <h4 class="timeline-title">{item.school}</h4>
                      <span class="timeline-period">{item.period}</span>
                      <p class="text-muted">{item.description}</p>
                    </div>
                  ))
                }
              </div>
            </div>
          </section>

          <!-- 3. PORTFOLIO -->
          <section id="portfolio" class="content-section">
            <h2 class="section-title">
              <i class="fa-solid fa-layer-group"></i> Portfolio
            </h2>
            <div class="portfolio-grid">
              {
                portfolioItems.map((item) => (
                  <a
                    href={item.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="portfolio-card"
                  >
                    <div
                      class="portfolio-img"
                      style={`background-image: url('${item.image}'); background-size: cover; background-position: center;`}
                    />
                    <h4>{item.title}</h4>
                    <p>{item.description}</p>
                  </a>
                ))
              }
            </div>
          </section>

          <!-- 4. CONTACT -->
          <section
            id="contact"
            class="content-section"
            style="padding-bottom: 5rem;"
          >
            <h2 class="section-title">
              <i class="fa-solid fa-envelope"></i> Contact Me
            </h2>
            <p class="text-muted">
              Let's collaborate and build your next great project together.
            </p>
            <form class="contact-form mt-4" id="contact-form">
              <input
                type="text"
                name="name"
                placeholder="Your Name"
                class="form-input"
                required
              />
              <input
                type="email"
                name="email"
                placeholder="Your Email"
                class="form-input"
                required
              />
              <textarea
                name="message"
                placeholder="Your Message"
                rows="4"
                class="form-input"
                required
              ></textarea>
              <button type="submit" class="btn-primary">Send Message</button>
              <div id="form-message" class="form-message" aria-live="polite"></div>
            </form>
          </section>
        </div>
      </main>
    </div>
  </body>
</html>

<script>
  const scrollContainer = document.querySelector(".scrollable-area");
  const sections = [...document.querySelectorAll(".content-section")];
  const navLinks = [...document.querySelectorAll(".inner-navbar a")];

  const setActiveLink = (sectionId: string | null) => {
    const targetHash = sectionId ? `#${sectionId}` : "#about";

    navLinks.forEach((link) => {
      const isActive = link.getAttribute("href") === targetHash;
      link.classList.toggle("active", isActive);
    });
  };

  navLinks.forEach((link) => {
    link.addEventListener("click", function (this: HTMLAnchorElement) {
      navLinks.forEach((item) => item.classList.remove("active"));
      this.classList.add("active");
    });
  });

  const observerRoot = window.innerWidth > 900 ? scrollContainer : null;

  const observer = new IntersectionObserver(
    (entries) => {
      const visibleEntries = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

      if (visibleEntries.length > 0) {
        const activeId = visibleEntries[0].target.getAttribute("id");
        setActiveLink(activeId);
      }
    },
    {
      root: observerRoot,
      rootMargin: "0px 0px -45% 0px",
      threshold: [0.2, 0.5, 0.8],
    },
  );

  sections.forEach((section) => observer.observe(section));
  setActiveLink("about");

  const contactForm = document.getElementById("contact-form") as HTMLFormElement | null;
  const formMessage = document.getElementById("form-message") as HTMLDivElement | null;

  if (contactForm) {
    contactForm.addEventListener("submit", function (this: HTMLFormElement, e: SubmitEvent) {
      e.preventDefault();

      const formData = new FormData(this);
      const data = {
        name: String(formData.get("name") ?? "").trim(),
        email: String(formData.get("email") ?? "").trim(),
        message: String(formData.get("message") ?? "").trim(),
      };

      if (!data.name || !data.email || !data.message) {
        if (formMessage) {
          formMessage.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Please complete all fields before sending.';
          formMessage.className = "form-message error";
        }
        return;
      }

      console.log("Form submitted:", data);

      if (formMessage) {
        formMessage.innerHTML = `<i class="fa-solid fa-check-circle"></i> Message sent successfully! Thank you, ${data.name}.`;
        formMessage.className = "form-message success";
      }

      this.reset();

      setTimeout(() => {
        if (formMessage) {
          formMessage.innerHTML = "";
          formMessage.className = "form-message";
        }
      }, 5000);
    });
  }
</script>
